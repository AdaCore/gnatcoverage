pragma Warnings
  (Off, "redundant conversion, * is of type ""Unsigned_32""");
pragma Warnings
  (Off, "redundant conversion, * is of type ""Unsigned_64""");
pragma Warnings
  (Off,
   """Unsigned_32"" is already use-visible through previous use_type_clause");
pragma Warnings
  (Off,
   "use clause for type ""Interfaces.Unsigned_32"" has no effect");

--  We don't use the [] syntax (big refactoring for neglectible value): do not
--  let GNAT warn about () aggregates.
pragma Warnings
  (Off, "array aggregate using () is an obsolescent syntax, use [] instead");
